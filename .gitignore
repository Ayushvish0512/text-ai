# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment / secrets
.env
.env.*
*.env

# FastAPI / temp files
*.log

# LLM artifacts / local model binaries (large)

# Ignore specific GGUF downloaded for testing only
models/*.gguf
models/*.bin

# Keep the Models/ directory visible on GitHub (but still ignore any large model files inside)
!Models/
!Models/.gitkeep
models/*


